{
  "manifest_version": 3,
  "name": "passkeyd bridge",
  "version": "0.1.0",
  "description": "Routes WebAuthn on allowlisted sites to the local passkeyd authenticator.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.okta.com/*",
        "https://github.com/*",
        "https://webauthn.io/*",
        "http://localhost/*"
      ],
      "js": [
        "content-isolated.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.okta.com/*",
        "https://github.com/*",
        "https://webauthn.io/*",
        "http://localhost/*"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "key": "__GENERATED__"
}
